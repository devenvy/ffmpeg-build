{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // besides the CLI (package.json bin): the build worker (started by path, in Docker or natively:
  // src/build/modules.ts) and the engine's own scripts (run by hand or by its workflows)
  "entry": ["src/build/worker.ts", "scripts/*.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  // system tools some tests, the Apple checks and the MSYS2 check (cygpath) call when the machine has them;
  // cc compiles the Linux-only regression for the GnuTLS socket-read adapter
  "ignoreBinaries": ["arch", "lipo", "mkfifo", "jq", "cygpath", "cc"],
}
