{
  "name": "@devenvy/ffmpeg-build",
  "version": "0.0.1",
  "description": "Build FFmpeg your way: version, platforms, license, libraries and patches from one YAML file, with locked versions and checked licenses",
  "keywords": [
    "ffmpeg",
    "build",
    "cross-compile",
    "license",
    "codecs",
    "android",
    "ios",
    "windows",
    "linux",
    "macos"
  ],
  "homepage": "https://github.com/devenvy/ffmpeg-build#readme",
  "bugs": {
    "url": "https://github.com/devenvy/ffmpeg-build/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devenvy/ffmpeg-build.git"
  },
  "author": "Ryan Morris",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ffmpeg-build": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/building.md",
    "docs/getting-started.md",
    "docs/releases.md",
    "docs/targets.md",
    "ffmpeg",
    "images",
    "license-texts",
    "licenses.yml",
    "platforms",
    "platforms.yml",
    "profiles",
    "recipes",
    "schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "schema": "node scripts/gen-schema.ts",
    "dev": "node src/cli.ts",
    "prepare": "node scripts/build.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "guidelines:check": "code-guidelines check",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@devenvy/code-guidelines": "^3.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.4"
  },
  "prettier": "@devenvy/code-guidelines/prettier",
  "codeGuidelines": {
    "env": "node",
    "typescript": true,
    "angular": false,
    "vitest": true
  }
}
